# OpenAI-compatible API (DeepSeek / OpenAI / etc.)
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL=deepseek-chat

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://flow.houmq.cn,https://flow.houmq.cn

# PostgreSQL
# 本地裸跑（docker compose up postgres -d）用 localhost：
POSTGRES_PASSWORD=devflow
DATABASE_URL=postgresql://devflow:devflow@localhost:5432/devflow

# Docker 全栈部署用 postgres 主机名（见根目录 .env.docker.example）：
# DATABASE_URL=postgresql://devflow:change-me@postgres:5432/devflow

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_DAYS=7

# 分享链接前缀
# 本地 Vite：http://localhost:5173
# 生产：https://flow.houmq.cn
APP_PUBLIC_URL=http://localhost:5173

# Session 工作区目录（每个 conversation 一个子目录）
WORKSPACES_ROOT=./workspaces
AGENT_MAX_ITERATIONS=12
