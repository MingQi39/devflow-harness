# 复制为项目根目录 .env 后修改:
#   cp .env.docker.example .env

# ========== 必填：LLM API ==========
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL=deepseek-chat

# ========== CORS（与访问域名一致）==========
CORS_ORIGINS=http://flow.houmq.cn,https://flow.houmq.cn

# ========== PostgreSQL ==========
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://devflow:change-me-strong-password@postgres:5432/devflow

# ========== JWT ==========
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_DAYS=7

# ========== 分享链接前缀 ==========
APP_PUBLIC_URL=https://flow.houmq.cn
